# === Application ===
APP_NAME=FPMS
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://skms.example.com

# === Locale ===
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# === Maintenance ===
APP_MAINTENANCE_DRIVER=file

# === Bcrypt ===
BCRYPT_ROUNDS=12

# === Logging ===
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# === Database (MySQL) ===
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=skms
DB_USERNAME=root
DB_PASSWORD=

# === Sanctum (API Auth) ===
SANCTUM_STATEFUL_DOMAINS=skms.example.com

# === Session ===
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# === Broadcasting ===
BROADCAST_CONNECTION=log

# === Filesystem ===
FILESYSTEM_DISK=local

# === Queue (must be 'database' in production) ===
QUEUE_CONNECTION=database

# === Cache ===
CACHE_STORE=database

# === Redis (optional, for cache/queue) ===
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# === Mail ===
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=notifications@forig.org
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="FPMS <notifications@forig.org>"
MAIL_FROM_NAME="${APP_NAME}"

# === AWS / S3 (for file storage in production) ===
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=skms-files
AWS_URL=https://s3.amazonaws.com/skms-files
AWS_USE_PATH_STYLE_ENDPOINT=false
# For S3-compatible stores (e.g. MinIO, DigitalOcean Spaces):
# AWS_ENDPOINT=https://fra1.digitaloceanspaces.com

# === Vite ===
VITE_APP_NAME="${APP_NAME}"
