# === Application ===
APP_NAME=FPMS
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://skms.example.com

# === Locale ===
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# === Maintenance ===
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# === Bcrypt ===
BCRYPT_ROUNDS=12

# === Logging ===
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# === Database (MySQL) ===
# Production database connection
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=skms
DB_USERNAME=root
DB_PASSWORD=

# === Testing Database (MySQL) ===
# Used by phpunit.xml — must exist before running tests
# DB_DATABASE=skms_test

# === Sanctum (API Auth) ===
# Comma-separated list of frontend domains for SPA authentication
# Token-based API auth is used, so this is for SPA cookie auth fallback
SANCTUM_STATEFUL_DOMAINS=skms.example.com
# Token expiration in minutes (default: 1440 = 24 hours)
# SANCTUM_EXPIRATION=1440

# === Session ===
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# === Broadcasting ===
BROADCAST_CONNECTION=log

# === Filesystem ===
# Local disk for development, S3 for production
FILESYSTEM_DISK=local
# FILESYSTEM_DISK=s3

# === Queue (must be 'database' in production) ===
# In production, queue worker must run: php artisan queue:work
# Scheduled tasks: php artisan schedule:run (add to cron every minute)
QUEUE_CONNECTION=database

# === Cache ===
# Use 'database' for single-server, 'redis' for multi-server
CACHE_STORE=database
# CACHE_PREFIX=

# === Redis (optional, for cache/queue) ===
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# === Mail ===
# In production, use smtp with proper credentials
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=notifications@forig.org
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="FPMS <notifications@forig.org>"
MAIL_FROM_NAME="${APP_NAME}"
# For local development:
# MAIL_MAILER=log

# === AWS / S3 (for file storage in production) ===
# Required when FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=skms-files
AWS_URL=https://s3.amazonaws.com/skms-files
AWS_USE_PATH_STYLE_ENDPOINT=false
# For S3-compatible stores (e.g. MinIO, DigitalOcean Spaces):
# AWS_ENDPOINT=https://fra1.digitaloceanspaces.com

# === Vite ===
VITE_APP_NAME="${APP_NAME}"
